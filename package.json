{
  "name": "sao-paulo-bus-map",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive map of São Paulo public transport (SPTrans buses & trolleybuses, Metrô, CPTM) — GTFS + OSM + HMM map matching",
  "scripts": {
    "download": "bash pipeline/download.sh",
    "build": "node --max-old-space-size=10240 pipeline/build.mjs --all --tram all",
    "report": "node pipeline/report-gaps.mjs",
    "serve": "node pipeline/serve.mjs 8159",
    "lines": "node --max-old-space-size=10240 pipeline/lines.mjs",
    "audit": "node --max-old-space-size=10240 pipeline/audit.mjs"
  }
}
